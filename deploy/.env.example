# Plantilla de variables de entorno. Copiala a la raíz del proyecto como `.env`
# (NUNCA la subas a git: el .gitignore ya excluye .env).
#
#   cp deploy/.env.example .env
#   nano .env        # completá los valores
#   chmod 600 .env   # solo tu usuario puede leerla
#
# Formato KEY=VALUE, sin comillas, una por línea (lo lee systemd EnvironmentFile).

# Token del bot de Telegram (@BotFather). OJO: usá uno nuevo si el viejo quedó expuesto.
TELEGRAM_TOKEN=PONE_TU_TOKEN_ACA

# Chat(s) a notificar. Uno solo, o varios separados por coma.
TELEGRAM_CHAT_ID=6794945244

# Segundos entre chequeos en modo --loop (180 = 3 min).
CHECK_INTERVAL=180

# Umbral de precio en USD (opcional; si no, usa el de config.py = 300).
ALERT_THRESHOLD=300
